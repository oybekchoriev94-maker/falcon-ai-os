# Falcon Vision Edge — klinika kompyuterida to'ldiriladi.
# Bu faylni .env nomiga ko'chiring va haqiqiy qiymatlarni kiriting.
# Hech qachon git'ga commit qilmang (.gitignore'da allaqachon bloklangan).

# --- Falcon AI OS server ---
FALCON_API_BASE=https://falconmedai.uz
FALCON_TENANT_ID=oqtosh
FALCON_CLINIC_ID=oqtosh
FALCON_NODE_ID=oqtosh-edge-01

# Admin panel orqali (POST /api/v1/edge/nodes) node yaratilganda olinadi.
# Signing key faqat BIR MARTA ko'rsatiladi — shu yerga yozib qo'yilgach,
# admin javobidagi qiymatni hech qayerda saqlamang.
FALCON_KEY_ID=
FALCON_SIGNING_KEY=

# --- Hikvision NVR ---
NVR_HOST=192.168.1.100
NVR_PORT=554
NVR_USER=admin
NVR_PASSWORD=

# --- Aniqlash sozlamalari ---
# YOLO modeli: yolov8n.pt (eng tez, GPU'siz ham ishlaydi) yoki yolov8s.pt (aniqroq)
DETECTOR_MODEL=yolov8n.pt
DETECTOR_DEVICE=cuda:0
DETECTOR_CONF_THRESHOLD=0.5
# Bitta zonada ketma-ket hodisalar orasidagi eng kam interval (soniya) —
# kamera spam qilmasligi uchun
EVENT_COOLDOWN_SECONDS=60

# Lokal holat va navbat fayllari qayerda saqlansin
STATE_DIR=/var/lib/falcon-vision-edge
