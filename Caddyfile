falconmedai.uz {
    @api path /api/* /metrics /healthz /readyz /livez /api-docs
    # DIQQAT: bu ro'yxatda bo'lmagan har qanday yo'l Next.js frontendga
    # ketadi va 404 qaytaradi. Express (app) beradigan yangi statik fayl
    # qo'shsangiz — uni SHU YERGA ham qo'shish shart.
    @tma path /tma.html /scribe.html /dashboard.html /admin-tma.html /reception-booking.html /qr-pay.html /qr-pay-kiosk.html /face_id.html /face-kiosk.html /mini-app.html /referral_portal.html /face-capture.js /face-capture.css /telegram-webapp.js /models/*
    handle @api {
        reverse_proxy http://app:3000
    }
    handle @tma {
        reverse_proxy http://app:3000
    }
    handle {
        reverse_proxy http://frontend:3001
    }
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=*, microphone=*"
        -Server
    }
}

