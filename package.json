{
  "name": "falcon-ai-os",
  "version": "2.0.0",
  "description": "Falcon AI OS — Klinikalar uchun yaxlit AI ekotizim",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:make": "knex migrate:make --knexfile knexfile.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tunnel": "npx localtunnel --port 3000 --subdomain falcon-ai-os"
  },
  "keywords": [
    "klinika",
    "ai",
    "telegram",
    "face-id",
    "inventory"
  ],
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^10.57.0",
    "@vladmandic/face-api": "^1.7.12",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "localtunnel": "^2.0.2",
    "morgan": "^1.11.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.21.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "redis": "^4.7.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "telegraf": "^4.16.3",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.8"
  }
}
