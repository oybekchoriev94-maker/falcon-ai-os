# ============================================================
# TTS xizmati (OmniVoice) — GPU varianti (klinika kompyuteri)
#
# stt-service/Dockerfile.gpu bilan bir xil pattern. OmniVoice
# CUDA 12.8 wheel'lari bilan ishlaydi (torch 2.8.0+cu128) —
# PyTorch kutubxonalarni O'ZI bilan olib keladi, hostda faqat
# yetarlicha yangi NVIDIA drayver kerak.
#
# Hostda kerak:
#   - NVIDIA drayver (CUDA 12.8 mos, >=555 seriyasi tavsiya)
#   - nvidia-container-toolkit
# Tekshirish: docker run --rm --gpus all nvidia/cuda:12.8.0-base-ubuntu22.04 nvidia-smi
#
# VRAM: fp16'da ~2-3GB. RTX 2060 SUPER (8GB) yetarli — STT bilan
# birga ishlasa ham joy qoladi.
# ============================================================
FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip curl libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# OmniVoice talabi: torch 2.8.0+cu128
RUN pip3 install --no-cache-dir --break-system-packages \
      torch==2.8.0+cu128 torchaudio==2.8.0+cu128 \
      --extra-index-url https://download.pytorch.org/whl/cu128
RUN pip3 install --no-cache-dir --break-system-packages \
      "omnivoice" soundfile fastapi uvicorn

WORKDIR /app
COPY server.py .

EXPOSE 8082

# GPU sukut bo'yicha. Model keshi deploy'da yo'qolmasligi uchun
# docker-compose'da /cache volume ulanadi.
ENV DEVICE=cuda:0 \
    HF_HOME=/cache/hf

CMD ["python3", "server.py"]
