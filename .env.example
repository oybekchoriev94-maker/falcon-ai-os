# ============================================================
# Falcon AI OS — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://falcon:YOUR_DB_PASSWORD@db:5432/falcon_ai_os
POSTGRES_PASSWORD=YOUR_DB_PASSWORD

# ─── Authentication ─────────────────────────────────────────
JWT_SECRET=your-jwt-secret-min-32-chars-long
INTERNAL_SECRET=your-internal-secret-min-32-chars-long
ADMIN_PASSWORD=admin-password-for-backend-admin-interface

# ─── Telegram botlari ───────────────────────────────────────
TELEGRAM_TOKEN_PATIENT=
TELEGRAM_TOKEN_REFERRAL=

# ─── AI / External ──────────────────────────────────────────
GROQ_API_KEY=
SENTRY_DSN=

# ─── Seed parollari (development) ───────────────────────────
# PRODUCTIONDA BU PAROLLARNI ALBATTA O'ZGARTIRING!
SEED_CEO_PASSWORD=ceo-change-me-now
SEED_ADMIN_PASSWORD=admin-change-me-now
SEED_RECEPTION_PASSWORD=reception-change-me-now
SEED_DOCTOR_PASSWORD=doctor-change-me-now

# ─── Other ──────────────────────────────────────────────────
PUBLIC_URL=https://localhost
LOG_LEVEL=info
LOCAL_ONLY=true

# ─── To'lov provayderlari (ixtiyoriy — bo'sh bo'lsa offline/naqd rejim) ───
# DIQQAT: webhook imzo tekshiruvi shu kalitlarga bog'liq. Kalit bo'lmasa,
# kiruvchi to'lov tasdiqlari xavfsizlik uchun RAD ETILADI.
PAYME_MERCHANT_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
UZUM_TERMINAL_ID=
UZUM_SECRET=
CLINIC_CARD_NUMBER=
CLINIC_CARD_HOLDER=

# ─── Email (SMTP) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── STT (ovozdan matnga) ───
# Production modeli: rubaiSTT v2 medium (islomov/rubaistt_v2_medium),
# CTranslate2 int8 formatida. Model docker-compose.yml dagi `stt` xizmatida
# MODEL_NAME=/models/rubaistt-v2-medium-ct2 orqali beriladi va ./stt-models
# papkasidan mount qilinadi — bu yerda sozlanmaydi.
#
# STT_LOCAL=true  → lokal STT konteyneri (tavsiya, maxfiylik: audio binodan chiqmaydi)
# STT_CLOUD_FALLBACK=true → lokal ishlamasa cloud'ga o'tsin (bemor audiosi tashqariga chiqadi)
STT_LOCAL=true
STT_CLOUD_FALLBACK=false

# Sukut bo'yicha VPS'ning o'z konteyneri (compose ichidagi tarmoq nomi).
# Klinika kompyuteridagi GPU STT'ga o'tish uchun shu qiymatni tunnel
# manziliga o'zgartiring, masalan: https://stt.falconmedai.uz
WHISPER_URL=http://stt:8081
# Tunnel orqali internetga ochilgan STT uchun MAJBURIY (lokal Docker
# tarmog'ida bo'sh qoldirilishi mumkin). Bo'sh bo'lsa STT tokenni
# tekshirmaydi — ochiq endpoint'da bu klinika GPU'sini begonaga beradi.
STT_AUTH_TOKEN=

# Tibbiy atamalar prompti. Nafaqaga chiqarilgan eski model prompt bilan
# buzilardi; rubaiSTT'da bu TEKSHIRILMAGAN — sinamasdan yoqmang
# (scripts/stt-compare/03-compare.sh uz prompt).
STT_USE_PROMPT=false
