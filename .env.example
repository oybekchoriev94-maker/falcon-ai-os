# ============================================================
# Falcon AI OS — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ─── Database ────────────────────────────────────────────────
POSTGRES_PASSWORD=YOUR_URL_SAFE_DB_PASSWORD
APP_DATABASE_PASSWORD=YOUR_URL_SAFE_APP_DB_PASSWORD
DATABASE_URL=postgresql://falcon_app:YOUR_URL_SAFE_APP_DB_PASSWORD@db:5432/falcon_ai_os
PLATFORM_DATABASE_URL=postgresql://falcon:YOUR_URL_SAFE_DB_PASSWORD@db:5432/falcon_ai_os
MIGRATION_DATABASE_URL=postgresql://falcon:YOUR_URL_SAFE_DB_PASSWORD@db:5432/falcon_ai_os
RLS_ENFORCE_APP_ROLE=true

# CI immutable image teglarini deploy vaqtida beradi. Qo'lda build qilganda
# bu qiymatlarni bo'sh qoldirish mumkin — Compose lokal image nomlarini ishlatadi.
# BACKEND_IMAGE=your-dockerhub-user/falcon-ai-os:git-sha
# FRONTEND_IMAGE=your-dockerhub-user/falcon-ai-os-frontend:git-sha
# STT_IMAGE=your-dockerhub-user/falcon-ai-os-stt:git-sha

# ─── Authentication ─────────────────────────────────────────
JWT_SECRET=your-jwt-secret-min-32-chars-long
JWT_REFRESH_WINDOW_DAYS=7
INTERNAL_SECRET=your-internal-secret-min-32-chars-long
ADMIN_PASSWORD=admin-password-for-backend-admin-interface

# ─── Edge / NVR kamera integratsiyasi ──────────────────────
# Xavfsiz rollout: avval kalitni yarating, keyin modulni yoqing.
# openssl rand -hex 32
EDGE_INGEST_ENABLED=false
EDGE_KEY_ENCRYPTION_KEY=

# ─── Telegram botlari ───────────────────────────────────────
TELEGRAM_TOKEN_PATIENT=
TELEGRAM_TOKEN_REFERRAL=

# ─── AI / External ──────────────────────────────────────────
GROQ_API_KEY=
SENTRY_DSN=

# ─── Seed parollari (har bir muhitda noyob qiymat majburiy) ──
SEED_CEO_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_RECEPTION_PASSWORD=
SEED_DOCTOR_PASSWORD=

# ─── Other ──────────────────────────────────────────────────
PUBLIC_URL=https://falconmedai.uz
PUBLIC_DOMAIN=falconmedai.uz
SERVER_IP=167.233.44.193
LOG_LEVEL=info

# ─── LLM (matn tahlili: diktantdan ma'lumot ajratish, epikriz, agentlar) ───
# LOCAL_ONLY=true  → FAQAT lokal LLM (Ollama). Cloud'ga umuman chiqmaydi.
#                    Maxfiylik uchun tavsiya: diktant matnida bemor ismi,
#                    tashxisi va dorilari bo'ladi.
# LOCAL_ONLY=false → lokal ishlamasa GROQ_API_KEY orqali cloud'ga o'tadi
#                    (ma'lumot mamlakatdan chiqadi).
LOCAL_ONLY=true

# Ollama manzili. Konteyner ichida `localhost` — konteynerning O'ZI,
# shuning uchun bu qiymat MAJBURIY (bo'sh qoldirilsa lokal LLM ishlamaydi):
#   klinika kompyuteridagi Ollama tunnel orqali:  https://llm.falconmedai.uz
#   yoki mesh IP orqali:                          http://100.x.x.x:11434
#   host'dagi Ollama (lokal ishlab chiqish):      http://host.docker.internal:11434
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b

# ─── To'lov provayderlari (ixtiyoriy — bo'sh bo'lsa offline/naqd rejim) ───
# DIQQAT: webhook imzo tekshiruvi shu kalitlarga bog'liq. Kalit bo'lmasa,
# kiruvchi to'lov tasdiqlari xavfsizlik uchun RAD ETILADI.
PAYME_MERCHANT_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
UZUM_TERMINAL_ID=
UZUM_SECRET=
CLINIC_CARD_NUMBER=
CLINIC_CARD_HOLDER=

# ─── Email (SMTP) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── STT (ovozdan matnga) ───
# Production modeli: rubaiSTT v2 medium (islomov/rubaistt_v2_medium),
# CTranslate2 int8 formatida. Model docker-compose.yml dagi `stt` xizmatida
# MODEL_NAME=/models/rubaistt-v2-medium-ct2 orqali beriladi va ./stt-models
# papkasidan mount qilinadi — bu yerda sozlanmaydi.
#
# STT_LOCAL=true  → lokal STT konteyneri (tavsiya, maxfiylik: audio binodan chiqmaydi)
# STT_CLOUD_FALLBACK=true → lokal ishlamasa cloud'ga o'tsin (bemor audiosi tashqariga chiqadi)
STT_LOCAL=true
STT_CLOUD_FALLBACK=false

# Sukut bo'yicha VPS'ning o'z konteyneri (compose ichidagi tarmoq nomi).
# Klinika kompyuteridagi GPU STT'ga o'tish uchun shu qiymatni tunnel
# manziliga o'zgartiring, masalan: https://stt.falconmedai.uz
WHISPER_URL=http://stt:8081
# Tunnel orqali internetga ochilgan STT uchun MAJBURIY (lokal Docker
# tarmog'ida bo'sh qoldirilishi mumkin). Bo'sh bo'lsa STT tokenni
# tekshirmaydi — ochiq endpoint'da bu klinika GPU'sini begonaga beradi.
STT_AUTH_TOKEN=

# Tibbiy atamalar prompti. Nafaqaga chiqarilgan eski model prompt bilan
# buzilardi; rubaiSTT'da bu TEKSHIRILMAGAN — sinamasdan yoqmang
# (scripts/stt-compare/03-compare.sh uz prompt).
STT_USE_PROMPT=false

# TTS (OmniVoice) — navbatni ovoz bilan o'qib berish (kiosk TV karnayi).
# Bo'sh = o'chirilgan; endpoint'lar TTS_DISABLED qaytaradi, qolgan ishlaydi.
# Yoqish: docker compose --profile tts up -d, keyin TTS_URL=http://tts:8082
# (yoki STT kabi tunnel orqali klinika GPU kompyuteri).
TTS_URL=
TTS_AUTH_TOKEN=
# Saqlangan ovoz kloni nomi (tts-service /voices orqali yuklanadi), bo'sh = avto ovoz
TTS_VOICE=

# Medplum (FHIR) — klinik ma'lumotning asosiy manbai (roadmap PR #5).
# Bo'sh = integratsiya o'chirilgan; /api/medplum/* MEDPLUM_DISABLED qaytaradi.
# Yoqish: Medplum serverini ko'taring (yoki app.medplum.com), Project'dan
# Access Token oling. Bemor/qabul push: /api/medplum/sync/*.
MEDPLUM_BASE_URL=
MEDPLUM_ACCESS_TOKEN=

# Frappe HRMS — xodim reestri va davomat sinhronizatsiyasi (roadmap PR #9).
# Bo'sh = integratsiya o'chirilgan; /api/hrms/sync/* FRAPPE_DISABLED qaytaradi,
# staff CRUD va summary ichki rejimda ishlayveradi.
# Autentifikatsiya: Frappe User settings'dan API Key + API Secret (token auth).
FRAPPE_URL=
FRAPPE_API_KEY=
FRAPPE_API_SECRET=
# Frappe'dagi kompaniya nomi (Employee doc uchun majburiy maydon)
FRAPPE_COMPANY=

# ERPNext — ombor, dorixona va xarid (roadmap PR #11).
# Bo'sh = integratsiya o'chirilgan; /api/erpnext/* ERPNEXT_DISABLED qaytaradi,
# ichki ombor oqimlari ishlayveradi (push-only, bog'liqlik yo'q).
# Autentifikatsiya: ERPNext User settings'dan API Key + API Secret.
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# ERPNext kompaniya va ombor nomlari (Stock Entry uchun majburiy)
ERPNEXT_COMPANY=
ERPNEXT_WAREHOUSE=

# ── PR #8: Hujjat elektronlashtirish (OCR) ───────────────────────
# OCR_URL bo'sh = OCR o'chiq (hujjat STT/qo'lda matn yo'lidan kiradi).
# Hujjat rasmlari LOKAL qoladi — cloud OCR ishlatilmaydi.
# Misol: Tesseract konteyneri http://ocr:5000
OCR_URL=
OCR_AUTH_TOKEN=
OCR_TIMEOUT_MS=60000
# Hujjat fayllari saqlanadigan papka (public/ ostida bo'lmasin)
OCR_DIR=

# ── PR #15: Backup va monitoring ───────────────────────────────
# Kunlik PostgreSQL backup: scripts/backup-pg.sh (cronga qo'shing).
# Backup fayllar ./backups papkada (app konteynerida /backup).
BACKUP_RETENTION_DAYS=14
# Watchdog: backup shuncha soatdan eski bo'lsa alert beradi
BACKUP_MAX_AGE_HOURS=26
# Watchdog disk chegarasi (foiz)
WATCHDOG_DISK_LIMIT=90
# Telegram admin alertlari (ikkalasi bo'sh = faqat logga yoziladi).
# Alohida bot yarating va uni FAQAT adminlar guruhiga qo'shing.
ADMIN_TG_BOT_TOKEN=
ADMIN_TG_CHAT_ID=
