# Falcon AI OS — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

NODE_ENV=production
PORT=3000

# --- Database ---
DATABASE_URL=postgresql://falcon:YOUR_DB_PASSWORD@localhost:5432/falcon_ai_os
POSTGRES_PASSWORD=YOUR_DB_PASSWORD

# --- Secrets (generate with: openssl rand -hex 32) ---
JWT_SECRET=
INTERNAL_SECRET=
FACE_ENCRYPTION_KEY=

# --- Admin ---
ADMIN_EMAIL=admin@falconai.uz
ADMIN_PASSWORD=YourAdminPassword123

# --- Seed user passwords (change after first login) ---
SEED_CEO_PASSWORD=ceo-change-me-now
SEED_ADMIN_PASSWORD=admin-change-me-now
SEED_RECEPTION_PASSWORD=reception-change-me-now
SEED_DOCTOR_PASSWORD=doctor-change-me-now

# --- Required: Payment Gateways ---
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# --- Required: Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# --- Required: Telegram Bots ---
TELEGRAM_TOKEN_PATIENT=
TELEGRAM_TOKEN_REFERRAL=

# --- Optional: AI ---
GROQ_API_KEY=

# --- Optional: Monitoring ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# --- Deploy ---
PUBLIC_URL=https://your-domain.com
