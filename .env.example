# ============================================================
# Falcon AI OS — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ─── Database ────────────────────────────────────────────────
POSTGRES_PASSWORD=YOUR_URL_SAFE_DB_PASSWORD
APP_DATABASE_PASSWORD=YOUR_URL_SAFE_APP_DB_PASSWORD
DATABASE_URL=postgresql://falcon_app:YOUR_URL_SAFE_APP_DB_PASSWORD@db:5432/falcon_ai_os
PLATFORM_DATABASE_URL=postgresql://falcon:YOUR_URL_SAFE_DB_PASSWORD@db:5432/falcon_ai_os
MIGRATION_DATABASE_URL=postgresql://falcon:YOUR_URL_SAFE_DB_PASSWORD@db:5432/falcon_ai_os
RLS_ENFORCE_APP_ROLE=true

# CI immutable image teglarini deploy vaqtida beradi. Qo'lda build qilganda
# bu qiymatlarni bo'sh qoldirish mumkin — Compose lokal image nomlarini ishlatadi.
# BACKEND_IMAGE=your-dockerhub-user/falcon-ai-os:git-sha
# FRONTEND_IMAGE=your-dockerhub-user/falcon-ai-os-frontend:git-sha
# STT_IMAGE=your-dockerhub-user/falcon-ai-os-stt:git-sha

# ─── Authentication ─────────────────────────────────────────
JWT_SECRET=your-jwt-secret-min-32-chars-long
JWT_REFRESH_WINDOW_DAYS=7
INTERNAL_SECRET=your-internal-secret-min-32-chars-long
ADMIN_PASSWORD=admin-password-for-backend-admin-interface

# ─── Telegram botlari ───────────────────────────────────────
TELEGRAM_TOKEN_PATIENT=
TELEGRAM_TOKEN_REFERRAL=

# ─── AI / External ──────────────────────────────────────────
GROQ_API_KEY=
SENTRY_DSN=

# ─── Seed parollari (har bir muhitda noyob qiymat majburiy) ──
SEED_CEO_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_RECEPTION_PASSWORD=
SEED_DOCTOR_PASSWORD=

# ─── Other ──────────────────────────────────────────────────
PUBLIC_URL=https://falconmedai.uz
PUBLIC_DOMAIN=falconmedai.uz
SERVER_IP=167.233.44.193
LOG_LEVEL=info
LOCAL_ONLY=true

# ─── To'lov provayderlari (ixtiyoriy — bo'sh bo'lsa offline/naqd rejim) ───
# DIQQAT: webhook imzo tekshiruvi shu kalitlarga bog'liq. Kalit bo'lmasa,
# kiruvchi to'lov tasdiqlari xavfsizlik uchun RAD ETILADI.
PAYME_MERCHANT_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
UZUM_TERMINAL_ID=
UZUM_SECRET=
CLINIC_CARD_NUMBER=
CLINIC_CARD_HOLDER=

# ─── Email (SMTP) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── STT rejimi ───
# STT_LOCAL=true  → lokal o'zbek Whisper konteyneri (tavsiya, maxfiylik)
# STT_CLOUD_FALLBACK=true → lokal ishlamasa cloud'ga o'tsin (bemor audiosi tashqariga chiqadi)
STT_LOCAL=true
STT_CLOUD_FALLBACK=false
